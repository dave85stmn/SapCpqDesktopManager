<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.aspiredigital</groupId>
        <artifactId>cpqdesk-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>cpqdesk-app</artifactId>
    <name>CPQ Desk App</name>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Modules from this reactor -->
        <dependency>
            <groupId>com.aspiredigital</groupId>
            <artifactId>cpqdesk-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aspiredigital</groupId>
            <artifactId>cpqdesk-feature-quotesniffer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aspiredigital</groupId>
            <artifactId>cpqdesk-feature-customtable</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aspiredigital</groupId>
            <artifactId>cpqdesk-feature-setup</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>

        <!-- Tests (UI) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JavaFX run goal -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.aspiredigital.cpqdesk.shell.Application</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Compiler & Surefire inherit versions from parent pluginManagement -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useSystemClassLoader>true</useSystemClassLoader>
                    <argLine>
                        --add-opens javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                        --add-opens javafx.controls/javafx.scene.control=ALL-UNNAMED
                        --add-opens javafx.graphics/javafx.stage=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
